// /api/webhook-premium.js
// Recibe webhooks de Recurrente via Svix y activa Premium en Supabase

const SUPABASE_URL = 'https://ilcreewilnkchvozicyp.supabase.co';
const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlsY3JlZXdpbG5rY2h2b3ppY3lwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgwMDU3NTIsImV4cCI6MjA5MzU4MTc1Mn0.X5QoGsMIKU0oWd0q0qvKYxlbb1tZfMvttBxOwL0BCoM';

// Token de verificacion de Svix — poner el tuyo desde el dashboard de Svix
const SVIX_SECRET = 'whsec_XECG6MKLlkD7eTynodhQ098IW68sF9oF';

export default async function handler(req, res) {

  // Solo aceptar POST
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  // Leer body raw para verificar firma
  const payload = JSON.stringify(req.body);
  const svixId        = req.headers['svix-id'];
  const svixTimestamp = req.headers['svix-timestamp'];
  const svixSignature = req.headers['svix-signature'];

  console.log('Webhook recibido:', svixId);
  console.log('Payload:', payload.substring(0, 200));

  try {
    const { Webhook } = await import('svix');
    const wh = new Webhook(SVIX_SECRET);
    wh.verify(payload, {
      'svix-id':        svixId,
      'svix-timestamp': svixTimestamp,
      'svix-signature': svixSignature
    });
  } catch(err) {
    console.error('Firma invalida:', err.message);
    return res.status(400).json({ error: 'Invalid signature' });
  }

  const event = req.body;
  const tipo  = event.type || '';

  console.log('Tipo de evento:', tipo);
  console.log('Data:', JSON.stringify(event.data || {}).substring(0, 300));

  // Manejar eventos de suscripcion
  if (tipo === 'subscription' || tipo.startsWith('subscription')) {
    const data   = event.data || {};
    const status = data.status || data.state || '';
    const email  = data.customer_email || data.email ||
                   (data.customer && data.customer.email) || '';

    console.log('Email:', email, 'Status:', status);

    if (!email) {
      console.error('No se encontro email en el payload');
      return res.status(200).json({ ok: false, error: 'No email found' });
    }

    // Activar Premium — subscription activa
    if (status === 'active' || status === 'trialing' || status === 'activated') {
      const hasta = new Date();
      hasta.setFullYear(hasta.getFullYear() + 1);

      const r = await fetch(
        SUPABASE_URL + '/rest/v1/mascotas?email=eq.' + encodeURIComponent(email.toLowerCase()),
        {
          method: 'PATCH',
          headers: {
            'Content-Type':  'application/json',
            'apikey':        SUPABASE_KEY,
            'Authorization': 'Bearer ' + SUPABASE_KEY,
            'Prefer':        'return=minimal'
          },
          body: JSON.stringify({
            premium:        true,
            premium_hasta:  hasta.toISOString()
          })
        }
      );

      console.log('Supabase PATCH status:', r.status, 'email:', email);
      return res.status(200).json({ ok: r.ok, action: 'activated', email });
    }

    // Desactivar Premium — suscripcion cancelada o vencida
    if (status === 'canceled' || status === 'cancelled' ||
        status === 'expired'  || status === 'inactive') {

      const r = await fetch(
        SUPABASE_URL + '/rest/v1/mascotas?email=eq.' + encodeURIComponent(email.toLowerCase()),
        {
          method: 'PATCH',
          headers: {
            'Content-Type':  'application/json',
            'apikey':        SUPABASE_KEY,
            'Authorization': 'Bearer ' + SUPABASE_KEY,
            'Prefer':        'return=minimal'
          },
          body: JSON.stringify({
            premium:        false,
            premium_hasta:  null
          })
        }
      );

      console.log('Supabase PATCH desactivar status:', r.status, 'email:', email);
      return res.status(200).json({ ok: r.ok, action: 'deactivated', email });
    }

    // Evento de pago exitoso
    if (tipo === 'payment_intent' && (status === 'succeeded' || status === 'paid')) {
      const hasta = new Date();
      hasta.setFullYear(hasta.getFullYear() + 1);

      const r = await fetch(
        SUPABASE_URL + '/rest/v1/mascotas?email=eq.' + encodeURIComponent(email.toLowerCase()),
        {
          method: 'PATCH',
          headers: {
            'Content-Type':  'application/json',
            'apikey':        SUPABASE_KEY,
            'Authorization': 'Bearer ' + SUPABASE_KEY,
            'Prefer':        'return=minimal'
          },
          body: JSON.stringify({
            premium:        true,
            premium_hasta:  hasta.toISOString()
          })
        }
      );

      return res.status(200).json({ ok: r.ok, action: 'payment_activated', email });
    }

    console.log('Status no manejado:', status);
    return res.status(200).json({ ok: true, action: 'ignored', status });
  }

  return res.status(200).json({ ok: true, action: 'ignored', type: tipo });
}
