{
  "rewrites": [
    {
      "source": "/share",
      "destination": "/api/share"
    },
    {
      "source": "/grupos/:id",
      "destination": "/grupo.html"
    },
    {
      "source": "/grupos/:id.html",
      "destination": "/grupo.html"
    },
    {
      "source": "/webhook/premium",
      "destination": "/api/webhook-premium"
    },
    {
      "source": "/p/:uid",
      "destination": "/p.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/share",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Accept-Ranges",
          "value": "none"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/share",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Accept-Ranges",
          "value": "none"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; img-src 'self' data: blob: https: https://images.dog.ceo https://cdn2.thecatapi.com https://26.media.tumblr.com; connect-src 'self' https: wss:; font-src 'self' https: data:;"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/favico.jpg",
      "permanent": true
    }
  ]
}
