{
  "rewrites": [
    { "source": "/share", "destination": "/api/share" },
    { "source": "/grupos/:id", "destination": "/grupo.html" },
    { "source": "/grupos/:id.html", "destination": "/grupo.html" }
  ],
  "headers": [
    {
      "source": "/api/share",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/share",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    }
  ]
}
